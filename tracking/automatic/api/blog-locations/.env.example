# Gemini API key — get one free at https://aistudio.google.com/apikey
# (no credit card required for the free tier)
GEMINI_API_KEY=

# Gemini model to use (defaults to gemini-3.6-flash if unset). Flash/
# Flash-Lite models are fast, cheap-on-quota, and capable enough for
# this extraction task. Google has moved fast on deprecating older
# model names on the free tier — if you get a 404 "no longer available"
# error, check https://ai.google.dev/gemini-api/docs/models for the
# current model name and update this.
GEMINI_MODEL=gemini-3.6-flash

# RSS feed URL to poll for new posts. No default — every trip blog is
# different, so this must be set explicitly (e.g. a Substack feed URL
# ends in /feed, e.g. https://yourblog.substack.com/feed).
BLOG_FEED_URL=

# Path to the Google service account JSON key file, downloaded from the
# Google Cloud Console. Copy the file to gcp-service-account.json next to
# this .env (that filename is git-ignored) and leave the default path below,
# or point it elsewhere.
GCP_SA_KEY_PATH=./gcp-service-account.json

# ID of the Google Sheet (from its URL: /spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=

# Worksheet/tab name to write to (defaults to Blog if unset)
GOOGLE_SHEET_TAB=Blog

# How long to wait for the feed request, in seconds (defaults to 30).
REQUEST_TIMEOUT_SECONDS=30

# Manually chosen ID for the trip/voyage all locations from this run
# belong to (defaults to 0 if unset). A blog can cover more than one
# trip over time, so every extracted row is tagged with this value,
# letting the shared GeoJSON endpoint filter to one trip via ?group=.
# Change this to a new value when starting a new trip.
GROUP_ID=0