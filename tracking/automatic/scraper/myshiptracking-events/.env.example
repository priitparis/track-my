# MMSI of the ship to track (numeric, as a string), e.g. 276017710
SHIP_MMSI=

# Path to the Google service account JSON key file, downloaded from the
# Google Cloud Console. Copy the file to gcp-service-account.json next to
# this .env (that filename is git-ignored) and leave the default path below,
# or point it elsewhere.
GCP_SA_KEY_PATH=./gcp-service-account.json

# ID of the Google Sheet (from its URL: /spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=

# Worksheet/tab name to write to (defaults to Events if unset)
GOOGLE_SHEET_TAB=Events

# How many days back to request from MyShipTracking's event log
# (defaults to 30 if unset). The site only actually returns roughly the
# last 3 weeks regardless of this value, but a wider request is a safe
# default in case that changes.
LOOKBACK_DAYS=30

# How long to wait for each page request, in seconds (defaults to 30).
REQUEST_TIMEOUT_SECONDS=30
