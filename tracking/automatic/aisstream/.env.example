# AISStream.io API key — get one free at https://aisstream.io/authenticate
AISSTREAM_API_KEY=

# MMSI of the ship to track (numeric, as a string), e.g. 276017710
SHIP_MMSI=

# Path to the Google service account JSON key file, downloaded from the
# Google Cloud Console. Copy the file to gcp-service-account.json next to
# this .env (that filename is git-ignored) and leave the default path below,
# or point it elsewhere.
GCP_SA_KEY_PATH=./gcp-service-account.json

# ID of the Google Sheet (from its URL: /spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=

# Worksheet/tab name to write to (defaults to Auto if unset)
GOOGLE_SHEET_TAB=Auto

# How long to wait for a PositionReport before giving up, in seconds
# (defaults to 120 if unset). The ship's AIS interval varies with speed
# and movement state, so this may need adjusting. In GitHub Actions this
# is set directly in the workflow file, not from a secret — see its
# comments on balancing this against the cron interval and free-tier
# Actions minutes.
CONNECT_TIMEOUT_SECONDS=120
