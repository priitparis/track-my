# Path to the Google service account JSON key file, downloaded from the
# Google Cloud Console. Copy the file to gcp-service-account.json next to
# this .env (that filename is git-ignored) and leave the default path below,
# or point it elsewhere.
GCP_SA_KEY_PATH=./gcp-service-account.json

# ID of the Google Sheet (from its URL: /spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=

# Worksheet/tab names to read from (default to Scraper / Events if unset)
GOOGLE_SHEET_SCRAPER_TAB=Scraper
GOOGLE_SHEET_EVENTS_TAB=Events

# Path to write the generated status SVG to, relative to the repo root
# when run from CI, or any local path for testing.
# (defaults to status/status.svg if unset)
OUTPUT_SVG_PATH=status/status.svg
